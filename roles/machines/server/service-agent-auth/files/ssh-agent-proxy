#!/bin/bash
# Finds the most-active online MacBook via Tailscale and proxies a single SSH
# agent request through to its 1Password agent socket. Falls back to the local
# agent-witness socket when no MacBook is online.
# Intended to be run as a systemd service instance (Accept=yes),
# with stdin/stdout connected to the client socket.

set -euo pipefail

AGENT_WITNESS_SOCK="/run/agent-witness/agent.sock"
SSH_KEY="/etc/ssh-agent-proxy-key"
SSH_USER="evan"
LIB="/usr/local/libexec/agents/agent-auth-lib.sh"

source "$LIB"

HOST=$(agent_auth_find_macbook || true)

if [[ -z "$HOST" || "$HOST" == "null" ]]; then
	if [[ ! -S "$AGENT_WITNESS_SOCK" ]]; then
		echo "ssh-agent-proxy: no macbook online and agent-witness socket is unavailable" >&2
		exit 1
	fi

	echo "ssh-agent-proxy: no macbook online, using agent-witness" >&2
	exec socat STDIO "UNIX-CONNECT:$AGENT_WITNESS_SOCK"
fi

# No remote command is passed: the MacBook pins this key to a forced command
# (~/.ssh/ssh-agent-proxy-serve, managed in the dotfiles) that relays stdio to
# its 1Password agent socket. That keeps the key from being able to run anything
# else over there, and keeps the agent socket path defined on the machine that
# actually owns it.
exec ssh \
	-T \
	-i "$SSH_KEY" \
	-l "$SSH_USER" \
	-o IdentitiesOnly=yes \
	-o StrictHostKeyChecking=accept-new \
	-o ConnectTimeout=5 \
	-o BatchMode=yes \
	"$HOST"
