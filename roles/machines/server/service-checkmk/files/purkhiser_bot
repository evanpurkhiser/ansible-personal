#!/usr/bin/env python3

import os
import urllib.parse
import urllib.request


def notification_text():
    what = os.environ.get("NOTIFY_WHAT", "HOST")
    host = os.environ.get("NOTIFY_HOSTNAME", "unknown host")
    state = os.environ.get(f"NOTIFY_{what}STATE", "UNKNOWN")
    output = os.environ.get(f"NOTIFY_{what}OUTPUT", "No check output")
    service = os.environ.get("NOTIFY_SERVICEDESC")

    subject = host if service is None else f"{host} / {service}"
    return f"Checkmk: {subject} is {state}\n{output}"


request = urllib.request.Request(
    "http://host.containers.internal:9090/?"
    + urllib.parse.urlencode({"channel": "system-notices"}),
    data=notification_text().encode(),
    headers={"Content-Type": "text/plain"},
)
urllib.request.urlopen(request, timeout=10)
