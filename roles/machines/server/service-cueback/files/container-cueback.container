[Unit]
After=mnt-documents.mount

[Container]
Image=ghcr.io/evanpurkhiser/cueback:latest
ContainerName=cueback
User=1000:100
Volume=/etc/localtime:/etc/localtime:ro
Volume=/etc/cueback.toml:/etc/cueback.toml:ro
Volume=/mnt/documents/multimedia/djing/cueback:/recordings
Network=cueback.network:ip=10.0.0.10,mac=02:52:42:58:50:02
PodmanArgs=--authfile=/etc/containers/auth.json
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
