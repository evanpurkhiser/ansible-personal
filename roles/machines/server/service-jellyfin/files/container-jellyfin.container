[Unit]
After=mnt-documents.mount

[Container]
Image=docker.io/jellyfin/jellyfin:latest
ContainerName=jellyfin
User=1000:984
PublishPort=127.0.0.1:8096:8096
Volume=/var/lib/jellyfin/config:/config
Volume=/var/lib/jellyfin/cache:/cache
Volume=/mnt/documents/multimedia:/media:ro
Volume=/etc/localtime:/etc/localtime:ro
Environment=JELLYFIN_PublishedServerUrl=https://jellyfin.prk.network
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
