FROM localhost/mcp-proxy:latest

ARG JELLYFIN_MCP_VERSION=2026.924.1
ARG JELLYFIN_MCP_SHA256=77c2317e76a30b938cf8d7c4bbd7ae63fb47db9a683fabeaf23a989cf4914e8e

RUN apk add --no-cache curl && curl --fail --location --silent --show-error --output /tmp/jellyfin-mcp.tar.gz \
        "https://github.com/jaredtrent/jellyfin-mcp/releases/download/v${JELLYFIN_MCP_VERSION}/jellyfin-mcp_linux_x64.tar.gz" \
    && echo "${JELLYFIN_MCP_SHA256}  /tmp/jellyfin-mcp.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/jellyfin-mcp.tar.gz -C /usr/local/bin jellyfin-mcp \
    && chmod 0755 /usr/local/bin/jellyfin-mcp \
    && rm /tmp/jellyfin-mcp.tar.gz
