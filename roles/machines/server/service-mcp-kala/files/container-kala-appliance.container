[Container]
Image=ghcr.io/evanpurkhiser/kala-mcp:latest
ContainerName=kala-appliance
Volume=/var/lib/kala-mcp/charts:/charts
Volume=/var/lib/kala-mcp/output:/output
Volume=/var/lib/kala-mcp/run:/run/kala-mcp
Volume=/var/lib/kala-mcp/state:/state
StopTimeout=30
Network=none
PodmanArgs=--authfile=/etc/containers/auth.json
AutoUpdate=registry

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
