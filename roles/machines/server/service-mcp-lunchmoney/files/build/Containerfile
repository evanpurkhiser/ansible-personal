FROM docker.io/library/node:24-alpine AS node

ARG LUNCHMONEY_MCP_VERSION=3.0.0

RUN npm install --global "@akutishevsky/lunchmoney-mcp@${LUNCHMONEY_MCP_VERSION}" \
    && npm cache clean --force

FROM localhost/mcp-proxy:latest

RUN apk add --no-cache nodejs
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=node /usr/local/bin/lunchmoney-mcp /usr/local/bin/lunchmoney-mcp
