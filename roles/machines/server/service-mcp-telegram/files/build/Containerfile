FROM ghcr.io/astral-sh/uv:0.11.28-python3.13-alpine

ARG TELEGRAM_MCP_COMMIT=0910170285526d289420acb413b2f741ff2ae0bb
ARG TELEGRAM_MCP_SHA256=7f86aa400fd5e7cfa15792da71d973b42c7125ab73f3fcc690cc33496651bce8

WORKDIR /app

RUN apk add --no-cache curl \
    && curl --fail --location --silent --show-error \
        --output /tmp/telegram-mcp.tar.gz \
        "https://github.com/chigwell/telegram-mcp/archive/${TELEGRAM_MCP_COMMIT}.tar.gz" \
    && echo "${TELEGRAM_MCP_SHA256}  /tmp/telegram-mcp.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/telegram-mcp.tar.gz -C /app --strip-components=1 \
    && rm /tmp/telegram-mcp.tar.gz \
    && uv sync --frozen --no-dev \
    && apk del curl \
    && adduser --disabled-password --gecos "" appuser \
    && chown -R appuser:appuser /app

USER appuser

ENV PATH=/app/.venv/bin:$PATH

ENTRYPOINT ["telegram-mcp"]
