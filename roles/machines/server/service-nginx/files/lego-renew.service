[Unit]
Description=Renew prk.network TLS certificate

[Service]
Type=oneshot
StateDirectory=lego
StateDirectoryMode=0700
LoadCredential=cloudflare-dns-api-token:/etc/lego-cloudflare.token
Environment=CF_DNS_API_TOKEN_FILE=%d/cloudflare-dns-api-token
UMask=0077
ExecStart=/usr/bin/lego run \
  --path ${STATE_DIRECTORY} \
  --email evanpurkhiser@gmail.com \
  --accept-tos \
  --dns cloudflare \
  --dns.propagation.disable-rns \
  --domains prk.network \
  --domains *.prk.network \
  --deploy-hook /usr/local/bin/reload-nginx-certificate
