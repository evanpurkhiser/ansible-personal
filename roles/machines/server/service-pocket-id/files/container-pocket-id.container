[Container]
Image=ghcr.io/pocket-id/pocket-id:latest
ContainerName=pocket-id
PublishPort=127.0.0.1:1411:1411
Volume=/var/lib/pocket-id:/app/data
Volume=/etc/pocket-id/encryption-key:/run/secrets/encryption-key:ro
Volume=/etc/pocket-id/api-key:/run/secrets/api-key:ro
Environment=APP_URL=https://id.evanpurkhiser.com
Environment=ENCRYPTION_KEY_FILE=/run/secrets/encryption-key
Environment=STATIC_API_KEY_FILE=/run/secrets/api-key
Environment=PGID=0
Environment=PUID=0
Environment=TRUST_PROXY=true
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
