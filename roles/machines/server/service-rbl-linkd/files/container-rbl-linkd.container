[Unit]
After=mnt-documents.mount

[Container]
Image=ghcr.io/evanpurkhiser/rbxport:latest
ContainerName=rbl-linkd
HostName=server-linkd
Volume=/etc/rbl-linkd.toml:/etc/rbl-linkd.toml:ro
Volume=/mnt/documents/multimedia/djing:/djing:ro
AddCapability=NET_BIND_SERVICE
Network=rbl-linkd.network:ip=10.0.0.5,mac=02:52:42:58:50:01
PodmanArgs=--authfile=/etc/containers/auth.json
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
