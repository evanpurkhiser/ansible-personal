[Unit]
After=mnt-documents.mount

[Container]
Image=ghcr.io/evanpurkhiser/wilhelm-archive:latest
ContainerName=wilhelm-archive
PublishPort=127.0.0.1:9008:4100
Volume=/mnt/documents/multimedia/videos/astrology-videos:/library:ro
Volume=/var/lib/wilhelm-archive:/state
Environment=WILHELM_ARCHIVE_PUBLIC_URL=https://astro-vids.prk.network
PodmanArgs=--authfile=/etc/containers/auth.json
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
